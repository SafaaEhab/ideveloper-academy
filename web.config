<?xml version="1.0" encoding="utf-8"?>
<!--
  MonsterASP.NET / IIS entry point.

  The site folder must contain:
    web.config
    dist\server.cjs
    dist\public\...

  DATABASE_URL, JWT_SECRET and the rest are set in
  Control Panel → Website → Scripting → Environment variables.
  A local .env next to this file also works, and is read by dotenv.
-->
<configuration>
  <system.web>
    <!-- Suppress the ASP.NET version banner; the response-header rule below
         also removes the X-Powered-By header after the Node process writes it. -->
    <httpRuntime enableVersionHeader="false" />
  </system.web>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="node" arguments=".\dist\server.cjs" startupTimeLimit="90" stdoutLogEnabled="true" stdoutLogFile=".\App_Data\logs\node">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
        <!-- Kept outside dist\public, so snapshots are never public. -->
        <environmentVariable name="EXCEL_BACKUP_DIR" value="App_Data\excel-backups" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
