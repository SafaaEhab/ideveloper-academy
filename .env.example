# انسخ الملف ده لـ .env واملا القيم الحقيقية
# cp .env.example .env  (PowerShell: Copy-Item .env.example .env)

# اتصال الداتابيز - سيرفر فقط، اوعى تحط VITE_ في الأول
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslaccept=strict"

# مالك الموقع (أول أدمن)
OWNER_OPEN_ID=""
# إيميلات الأدمن (مفصولة بفاصلة) - أي لوجن بالإيميلات دي يبقى أدمن تلقائي
# مثال: ADMIN_EMAILS="admin1@gmail.com,admin2@gmail.com"
ADMIN_EMAILS=""

# OAuth / Session
JWT_SECRET="غيرها-لازم-تكون-طويلة-وعشوائية-32-حرف-على-الأقل"
OAUTH_SERVER_URL=""

# App
VITE_APP_ID=""
NODE_ENV="development"

# تقسيم النشر (Vercel للواجهة + سيرفر API لوحده) - سيبهم فاضيين لو السيرفر والواجهة على نفس الدومين
# رابط سيرفر الـ API اللي الواجهة هتكلمه (يتحط في Vercel كـ VITE_API_URL)
# مثال: VITE_API_URL="https://ideveloper-academy.onrender.com"
VITE_API_URL=""
# دومين الواجهة المسموح له يكلم الـ API (يتحط في السيرفر، مفصول بفاصلة لو أكتر من واحد)
# مثال: WEB_ORIGIN="https://ideveloper-two.vercel.app"
WEB_ORIGIN=""
