# انسخ الملف ده لـ .env واملا القيم الحقيقية
# cp .env.example .env  (PowerShell: Copy-Item .env.example .env)

# اتصال الداتابيز - سيرفر فقط، اوعى تحط VITE_ في الأول
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslaccept=strict"

# مالك الموقع (أول أدمن)
OWNER_OPEN_ID=""
# إيميلات الأدمن (مفصولة بفاصلة) - أي لوجن بالإيميلات دي يبقى أدمن تلقائي
# مثال: ADMIN_EMAILS="admin1@gmail.com,admin2@gmail.com"
ADMIN_EMAILS=""

# OAuth / Session
JWT_SECRET="غيرها-لازم-تكون-طويلة-وعشوائية-32-حرف-على-الأقل"
OAUTH_SERVER_URL=""

# App
VITE_APP_ID=""
NODE_ENV="development"
