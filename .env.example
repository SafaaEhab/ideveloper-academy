# انسخ الملف ده لـ .env واملا القيم الحقيقية
# cp .env.example .env  (PowerShell: Copy-Item .env.example .env)

# اتصال الداتابيز - سيرفر فقط، اوعى تحط VITE_ في الأول
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslaccept=strict"

# مالك الموقع (أول أدمن)
OWNER_OPEN_ID=""
# إيميل المالك هو الوحيد اللي بيشوف زرار Admins وقائمة مين عنده صلاحية وطلبات
# الوصول. لو سايبه فاضي هياخد أول إيميل في ADMIN_EMAILS自動的に.
OWNER_EMAIL=""
# إيميلات الأدمن (مفصولة بفاصلة) - أي لوجن بالإيميلات دي يبقى أدمن تلقائي
# مثال: ADMIN_EMAILS="admin1@gmail.com,admin2@gmail.com"
ADMIN_EMAILS=""

# OAuth / Session
JWT_SECRET="غيرها-لازم-تكون-طويلة-وعشوائية-32-حرف-على-الأقل"
OAUTH_SERVER_URL=""

# App
VITE_APP_ID=""
NODE_ENV="development"

# Cloudinary - رفع صور الإنجازات من صفحة الأدمن
# القيم دي من Cloudinary > Settings > API Keys (سيرفر فقط، متحطهاش في متغيرات VITE_)
# لو فاضيين، الأدمن يقدر يلصق رابط الصورة بدل ما يرفعها
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── تقسيم النشر: واجهة Vercel + باك اند MonsterASP ───────────────────────────
# على Vercel حط: VITE_API_URL="https://ideveloper-academy.runasp.net"
# (ده build-time، فلازم تعمل redeploy بعد إضافته)
VITE_API_URL=""
# على Monster حط: WEB_ORIGIN="https://ideveloper-academy.vercel.app"
# ده بيسمح للواجهة تكلم الـ API ويخلي الكوكيز SameSite=None; Secure
WEB_ORIGIN=""

# ── إرسال إيميل طلبات الوصول (Gmail SMTP) ──────────────────────────────────────
# GMAIL_USER = إيميلك على Gmail (هو اللي هيتبعت عليه الطلبات)
# GMAIL_APP_PASSWORD = App Password من Google Account → Security → 2-Step
#   Verification → App passwords (16 حرف). مش باسورد حسابك العادي.
# لو فاضيين، الطلبات هتتسجل وهتظهر في تبويب Admins بس من غير إيميل.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# دومين الموقع — بيتحط في لينك "راجع الطلب" اللي جوه الإيميل
SITE_URL="https://ideveloper-academy.vercel.app"

# ── نسخة Excel الاحتياطية ─────────────────────────────────────────────────────
# كل تعديل ناجح في الداتابيز بيعمل نسخة .xlsx تلقائيًا في الفولدر ده.
# على MonsterASP سيبها App_Data\excel-backups (بره مجلد الموقع العام وبتفضل
# موجودة بعد كل نشر). النسخة الأولى من كل يوم بتتبعت على الإيميل لو Gmail متظبط.
EXCEL_BACKUP_DIR="App_Data\excel-backups"
# كل كام دقيقة تعمل نسخة حتى لو مفيش تعديلات (الافتراضي 30)
EXCEL_BACKUP_INTERVAL_MINUTES="30"
# عدد النسخ اللي تتحفظ (الافتراضي 120)
EXCEL_BACKUP_KEEP="120"
# عشان تقدر توقفها مؤقتًا: false
EXCEL_BACKUP_ENABLED="true"
# فولدر صور الإنجازات لو Cloudinary مش متظبط (الافتراضي App_Data/uploads/achievements)
UPLOAD_DIR="App_Data/uploads/achievements"

# ── Phase 1: العملاء المحتملون + Google Sheets ────────────────────────────────
# Service Account من Google Cloud (Editor على الشيت أو Viewer + مشاركة الشيت
# مع إيميل الـ service account بصلاحية Editor). القيم سيرفر فقط.
GOOGLE_SHEETS_ENABLED="true"
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=""
# الخرج من JSON key: private_key (سطر واحد فيه \n أو عدة أسطر)
GOOGLE_SHEETS_PRIVATE_KEY=""
# معرف الشيت من الرابط: /spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SHEETS_SHEET_NAME="Leads"
# بديل: ضع ملف الاعتماد كاملًا في متغير واحد (JSON)
# GOOGLE_SHEETS_CREDENTIALS_JSON=""
# تنبيه "متأخر في الاتصال" للعملاء الجدد بعد كام ساعة (الافتراضي 24)
LEAD_OVERDUE_HOURS="24"
# عامل المزامنة الخلفي: كل كام مللي ثانية + سياسة retry
LEAD_SYNC_INTERVAL_MS="20000"
LEAD_SYNC_MAX_ATTEMPTS="8"
LEAD_SYNC_RETRY_BASE_MS="60000"

# ── النشر على MonsterASP.NET ───────────────────────────────────────────────────
# راجع docs/monsterasp-deployment.md للخطوات الكاملة.
# بناء الحزمة:
#   pnpm build
#   pnpm package:monster
# ثم ارفع release\monsterasp\monsterasp-site.zip من Website → Files
# وفك الضغط داخل /wwwroot.
#
# متغيرات MonsterASP المطلوبة (Website → Scripting → Environment variables):
#   DATABASE_URL, JWT_SECRET, ADMIN_EMAILS, OWNER_EMAIL,
#   SITE_URL (رابط Vercel), WEB_ORIGIN (رابط Vercel),
#   GMAIL_USER, GMAIL_APP_PASSWORD (اختياري), EXCEL_BACKUP_DIR,
#   GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL, GOOGLE_SHEETS_PRIVATE_KEY,
#   GOOGLE_SHEETS_SPREADSHEET_ID, GOOGLE_SHEETS_SHEET_NAME
#
# متغير Vercel المطلوب:
#   VITE_API_URL="https://ideveloper-academy.runasp.net"
# ثم: npx vercel --prod
